# ===== 主数据库（存放系统自身数据）=====
# sqlite（默认）或 mysql；修改后重启服务生效
DB_TYPE=sqlite

# SQLite 配置
SQLITE_PATH=./qabot.db

# MySQL 配置（仅 DB_TYPE=mysql 时使用）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=qabot
MYSQL_USER=qabot
MYSQL_PASSWORD=change-me

# 可选：直接提供 SQLAlchemy URL 时会覆盖上面的全部数据库配置
# DATABASE_URL=mysql+pymysql://qabot:change-me@127.0.0.1:3306/qabot?charset=utf8mb4

# ===== 安全 =====
# JWT 签名密钥（生产环境务必修改）
SECRET_KEY=6gd4kur9v8W7QoGufE1tahS_PpM5t9AOYeQ3l-xa_XQpNSjcFKcCLDykbnaw1aNz
# AES 加密密钥（用于数据库密码 / API Key 加密存储），任意字符串，内部会派生成 32 字节
AES_KEY=xStXKn8PTR66xrjkf8NmZu1vghmH9IgMwrcgSiluMyU

# JWT 过期时间（小时）
TOKEN_EXPIRE_HOURS=24
# 勾选“记住我”时的过期时间（小时）
TOKEN_REMEMBER_HOURS=720

# 仅本地 Web 联调可启用验证码回显。桌面版始终禁用注册和找回密码。
QA_DEV_AUTH=0
# Web 模式可修改共享 AI 配置的管理员用户 ID（逗号分隔）。
QA_ADMIN_USER_IDS=
# Web 服务默认不允许使用任意服务器本地文件，桌面版允许选择本机文件。
QA_ALLOW_LOCAL_FILES=0

# ===== DeepSeek（可在系统配置接口中覆盖）=====
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

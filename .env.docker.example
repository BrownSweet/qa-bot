# sqlite 或 mysql
DB_TYPE=sqlite
APP_PORT=8080

# MySQL 配置（DB_TYPE=mysql 时使用）
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=qabot
MYSQL_USER=qabot
MYSQL_PASSWORD=请修改数据库密码
MYSQL_ROOT_PASSWORD=请修改Root密码

# 可选：设置后会覆盖 DB_TYPE 及上述数据库连接参数
# DATABASE_URL=

# 生产环境务必改为足够长的随机字符串
SECRET_KEY=请修改JWT签名密钥
AES_KEY=请修改数据加密密钥

TOKEN_EXPIRE_HOURS=24
TOKEN_REMEMBER_HOURS=720

DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
